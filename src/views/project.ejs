<%- include('partials/header') %>

<main>
    <h1><%= project.title %></h1>

    <p>
        <a href="/edit-project/<%= project.project_id %>">Edit Project</a>
    </p>

        <strong>Description:</strong>
        <%= project.description %>
    </p>


    <p>
        <strong>Date:</strong>
        <%= project.project_date %>
    </p>

    <p>
        <strong>Location:</strong>
        <%= project.location %>
    </p>

    <p>
        <strong>Partner Organization:</strong>
        <a href="/organization/<%= project.organization_id %>">
            <%= project.organization_name %>
        </a>
    </p>

    <p>
        <a href="/assign-categories/<%= project.project_id %>"
            >Edit Categories</a>
    </p>

    <p>
        <strong>Categories:</strong>
        <% categories.forEach(category => { %>
            <a href="/category/<%= category.category_id %>" class="tag">
                <%= category.category_name %>
            </a>
        <% }) %>
    </p>

    <% if (user && user.role_name === 'admin') { %>
        <a href="/edit-project/<%= project.project_id %>">Edit Project</a>
    <% } %>
    
</main>

<%- include('partials/footer') %>