<%- include('partials/header') %>

<main>
    <h1>Edit Service Project</h1>

    <form action="/edit-project/<%= project.project_id %>" method="POST">

        <div class="form-group">

            <div>
                <label for="title">Title</label>
                <input
                    type="text"
                    id="title"
                    name="title"
                    value="<%= project.title %>"
                    required
                />
            </div>

            <div>
                <label for="description">Description</label>
                <textarea
                    id="description"
                    name="description"
                    required
                ><%= project.description %></textarea>
            </div>

            <div>
                <label for="location">Location</label>
                <input
                    type="text"
                    id="location"
                    name="location"
                    value="<%= project.location %>"
                    required
                />
            </div>

            <div>
                <label for="project_date">Date</label>
                <input
                    type="date"
                    id="project_date"
                    name="project_date"
                    value="<%= project.project_date ? new Date(project.project_date).toISOString().split('T')[0] : '' %>"
                    required
                />
            </div>

            <div>
                <label for="organizationId">Partner Organization</label>
                <select id="organizationId" name="organizationId" required>
                    <% organizations.forEach(org => { %>
                        <option
                            value="<%= org.organization_id %>"
                            <%= org.organization_id === project.organization_id ? 'selected' : '' %>>
                            <%= org.name %>
                        </option>
                    <% }); %>
                </select>
            </div>

        </div>

        <button type="submit">Update Project</button>

    </form>
</main>

<%- include('partials/footer') %>