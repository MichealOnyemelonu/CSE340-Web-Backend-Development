<h1><%= title %></h1>

<table>
    <thead>
        <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Role</th>
        </tr>
    </thead>

    <tbody>
        <% users.forEach(user => { %>
            <tr>
                <td>
                    <%= user.user_firstname %>
                    <%= user.user_lastname %>
                </td>

                <td>
                    <%= user.user_email %>
                </td>

                <td>
                    <%= user.user_role %>
                </td>
            </tr>
        <% }) %>
    </tbody>
</table>