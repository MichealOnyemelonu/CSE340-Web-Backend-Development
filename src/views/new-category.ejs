<%- include('partials/header') %>

<main>
    <h1>Create Category</h1>

    <form action="/new-category" method="POST">
        <div>
            <label for="category_name">Category Name</label>
            <input
                type="text"
                id="category_name"
                name="category_name"
                required
                maxlength="100"
            />
        </div>

        <button type="submit">Create</button>
    </form>
</main>

<%- include('partials/footer') %>